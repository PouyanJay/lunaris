# syntax=docker/dockerfile:1
# Trusted supervisor only. Generated programs run in separate restricted containers.
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /usr/local/bin/uv
ENV UV_PYTHON_PREFERENCE=only-system UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --package lunaris-api --no-dev

FROM python:3.12-slim AS runtime
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 LUNARIS_ENV=production
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 app
COPY --from=docker.io/library/docker:cli@sha256:eccaacfeed644c7de222ff047483568cb988dde95476fbaaf10ea2d04921bb66 /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
COPY --from=builder --chown=app:app /app /app
COPY infra/sim-verifier/seccomp.json /etc/lunaris/sim-seccomp.json
USER app
RUN python -c "import lunaris_api.live.sim_worker_entrypoint"
CMD ["python", "-m", "lunaris_api.live.sim_worker_entrypoint"]
